{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/oept/schema/rule-trace/0.1",
  "title": "OEPT RuleTrace",
  "description": "The record of one deterministic evaluation: what ran, what inputs, what resulted. OEPT standardizes the record, not business logic. Pre-1.0 provisional namespace.",
  "type": "object",
  "required": ["id", "rule_id", "rule_version", "engine", "result"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "rule_id": { "type": "string", "minLength": 1 },
    "rule_version": { "type": "string", "minLength": 1 },
    "engine": { "type": "string", "minLength": 1 },
    "input_revision_ids": { "type": "array", "items": { "type": "string" } },
    "result": { "type": "string", "enum": ["PASS", "FLAG", "UNVERIFIABLE", "ERROR"] },
    "trace": { "type": "object" },
    "missing_inputs": { "type": "array", "items": { "type": "string" } },
    "executed_at": { "type": "string" }
  },
  "additionalProperties": false
}
